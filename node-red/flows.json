    {
        "id": "433575efdcd4619c",
        "type": "function",
        "z": "d6bbecfbf072dc0d",
        "name": "Sterowanie AUTO",
        "func": "var mode = flow.get('motor_mode') || 'auto';\nif (mode !== 'auto') return null;\n\nvar temp = flow.get('last_temp') || 0;\nvar gas = flow.get('last_gas') || 0;\nvar temp_thr = flow.get('temp_threshold') || 30;\nvar gas_thr = flow.get('gas_threshold') || 3000;\nvar gas_max = 10000;\n\nvar speed_gas = 0;\nvar speed_temp = 0;\n\nif (gas >= gas_max) {\n    speed_gas = 255;\n} else if (gas >= gas_thr) {\n    var ratio = (gas - gas_thr) / (gas_max - gas_thr);\n    speed_gas = Math.round(ratio * 255);\n    speed_gas = Math.max(speed_gas, 50); // Minimum 50, żeby silnik ruszył\n}\n\n\nif (temp >= temp_thr) {\n    speed_temp = 80;\n}\n\n\nvar final_speed = Math.max(speed_gas, speed_temp);\n\nnode.status({\n    fill: final_speed > 0 ? 'green' : 'grey',\n    shape: 'dot',\n    text: 'G:' + speed_gas + ' T:' + speed_temp + ' -> Run:' + final_speed\n});\n\nmsg.payload = JSON.stringify({ command: 'set_speed', value: final_speed });\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 320,
        "wires": [
            [
                "2df032437b46bc18"
            ]
        ]
    },
    {
        "id": "a1b617479fdb85ce",
        "type": "function",
        "z": "d6bbecfbf072dc0d",
        "name": "Sprawdź Alerty",
        "func": "var temp = flow.get('last_temp') ?? 0;\nvar gas = flow.get('last_gas') ?? 0;\n\nvar temp_thr = flow.get('temp_threshold') ?? 30;\nvar gas_thr = flow.get('gas_threshold') ?? 3000;\n\nvar now = Date.now();\nvar lastAlert = flow.get('last_alert_time') || 0;\nvar cooldown = 5 * 60 * 1000;\n\nif (now - lastAlert < cooldown) {\n    node.status({fill:'yellow', shape:'ring', text:'Oczekiwanie na koniec cooldownu'});\n    return null;\n}\n\nvar alerts = [];\n\nif (temp >= temp_thr) {\n    alerts.push('UWAGA! Wysoka temperatura: ' + temp.toFixed(1) + 'C (prog: ' + temp_thr + 'C)');\n}\nif (gas >= gas_thr) {\n    alerts.push('ALARM! Wysokie stezenie gazu: ' + Math.round(gas) + ' PPM (prog: ' + gas_thr + ' PPM)');\n}\n\nif (alerts.length > 0) {\n    flow.set('last_alert_time', now);\n    msg.payload = alerts.join(' | ');\n    msg.topic = 'IoT Alert - ' + new Date().toLocaleString('pl-PL');\n    \n    node.status({fill:'red', shape:'dot', text:'ALERT WYSŁANY!'});\n    return msg;\n}\n\nnode.status({fill:'green', shape:'dot', text:'Parametry w normie'});\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 400,
        "wires": [
            [
                "04718574a4273130",
                "f6e93abc3b70f6eb"
            ]
        ]
    },
