    {
        "id": "3c93af1a53179971",
        "type": "function",
        "z": "d6bbecfbf072dc0d",
        "name": "Ustaw tryb",
        "func": "if (msg.payload === 1) {\n    flow.set('motor_mode', 'auto');\n    node.status({fill:'green', shape:'dot', text:'AUTO'});\n    return null;\n} else {\n    flow.set('motor_mode', 'manual');\n    node.status({fill:'yellow', shape:'dot', text:'MANUAL'});\n    var manual_speed = flow.get('last_manual_speed') || 0;\n    msg.payload = JSON.stringify({command: 'set_speed', value: manual_speed});\n    return msg;\n}",
